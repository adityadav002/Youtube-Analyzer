# ==========================================
# YouTube Video Analyzer - Backend Env Template
# ==========================================

# Flask settings
FLASK_ENV=production
SECRET_KEY=generate-a-secure-random-key-in-production
LOG_LEVEL=INFO

# Database connection
# Direct URL connection (supports PostgreSQL e.g. on Render, and MySQL locally)
# Render format: postgresql://username:password@hostname/database_name
# MySQL format: mysql+pymysql://username:password@hostname:3306/database_name
DATABASE_URL=

# Alternative MySQL configuration components (used if DATABASE_URL is not set)
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=youtube_analyzer

# Redis / Celery (Optional, set USE_CELERY=false to use in-process background threads)
USE_CELERY=false
REDIS_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Storage (Leave blank to use default ./downloads and ./thumbnails folders relative to backend)
DOWNLOAD_DIR=
THUMBNAIL_DIR=

# Media Download & OS Integration Flags
ENABLE_DOWNLOADS=true
ENABLE_LOCAL_FILE_OPEN=true
RATELIMIT_STORAGE_URI=memory://
SEARCH_CACHE_TTL_HOURS=24

# yt-dlp Settings
YTDLP_COOKIES_PATH=
YTDLP_PROXY=
YTDLP_PLAYER_CLIENT=ios
YTDLP_RATE_LIMIT=500K
POT_PROVIDER_URL=

# YouTube Data API v3 (Required for video search, metadata fetching, channel crawl)
YOUTUBE_API_KEY=

# AI / Sentiment Analysis (Google Gemini 1.5 Flash)
AI_PROVIDER=gemini
GEMINI_API_KEY=
AI_MODEL=gemini-1.5-flash

# CORS Configuration
# Set to the URL of your deployed frontend (e.g., https://youtube-analyzer-frontend.onrender.com)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Feature Flags
AUTO_EXTRACT_TRANSCRIPT=false
AUTO_EXTRACT_THUMBNAIL=true
RSS_POLL_INTERVAL=60
MAX_CONCURRENT_DOWNLOADS=2
